# Copy this file to .env and fill in your actual values.
# IMPORTANT: Never commit .env to version control.

# ---------------------------------------------------------------------------
# PostgreSQL — the serving layer
# ---------------------------------------------------------------------------
# This file is NOT read automatically; nothing in the project loads .env. Export
# it into the environment first:
#
#     set -a; . .env; set +a
#
# Give the database EITHER as one URL (below) OR as the discrete PG* settings
# further down. DATABASE_URL wins if both are set.
#
# `docker compose up -d` starts a local server matching the URL below, and
# `uv run python db/bootstrap.py --sqlite mk_tracking.db` fills it.
DATABASE_URL=postgresql://mk:mk@127.0.0.1:5432/mk_tracking

# The deployment platform injects DB_URI instead of DATABASE_URL. It is read as
# a fallback, so a deployed server needs nothing set here; DATABASE_URL wins if
# both are present.
# DB_URI=postgresql://app:password@host:5432/app

# Discrete settings, for a hosted database that is handed over as separate
# fields rather than a URL. Used only when DATABASE_URL is unset. Keeping the
# password in its own variable also keeps it off the command line, where `ps`
# would expose it. PGDATABASE plus one of PGHOST/PGPORT is the minimum.
# PGHOST=db.example.com
# PGPORT=5432
# PGUSER=mk
# PGPASSWORD=
# PGDATABASE=mk_tracking
# PGSSLMODE=require          # a hosted database needs this; a local one does not

# Schema holding the tables. Rarely changed.
# MK_TRACKING_SCHEMA=mk_tracking

# Serving backend: `postgres` (default) or `json` (offline UI fixture).
# There is deliberately no BigQuery option.
MK_WORK_DATA_BACKEND=postgres

# ---------------------------------------------------------------------------
# Ingestion pipeline only — not needed to serve the site
# ---------------------------------------------------------------------------

# X (Twitter) API v2 Bearer Token
# Obtain from https://developer.twitter.com/en/portal/dashboard
# Requires Academic Research access or equivalent.
X_BEARER_TOKEN=your-x-api-bearer-token

# Google Gemini API Key
# Obtain from https://aistudio.google.com/app/apikey
# Used for embeddings and text summarization. The inference APIs are out of
# scope for the PostgreSQL migration and still run on Google Cloud.
GEMINI_API_KEY=your-gemini-api-key

# ---------------------------------------------------------------------------
# Unported BigQuery steps only — see TODO(postgres-migration) markers.
# Needed solely when running run_daily_pipeline.sh with
# MK_TRACKING_ALLOW_BIGQUERY=1.
# ---------------------------------------------------------------------------
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
