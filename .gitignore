# Python-generated files
__pycache__/
.pytest_cache/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Output data.
# NOTE: this must be `data/*`, not `data/` — git will not descend into an
# excluded directory, so a negation inside one has no effect.
data/*
# The issue taxonomy is source, not output. The pipeline and
# tests/test_pipeline.py both depend on it.
!data/seed/
!data/seed/**
ui/data/
ui/raw/

# Temporary files
found_mks.*
scratch/

# analyze_votes generated reports/datasets (regenerated by the scripts; never commit)
src/mk_tracking/analyze_votes/*.csv
src/mk_tracking/analyze_votes/*.json
src/mk_tracking/analyze_votes/analysis_summary.md
src/mk_tracking/analyze_votes/gemini_evaluations_cache.json

# Node / Frontend
node_modules/
*.tsbuildinfo

# OS / System
.DS_Store

# Editor and agent config directories
.obsidian/
.gemini/
.opencode/
.claude/
.agents/
